# DutyBoard settings for development. Copy this file to .env.
# Never commit .env: it holds your encryption key and passwords.

APP_NAME=DutyBoard
APP_ENV=local
# Generate with: docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# The postgres container in compose.yaml uses these to create the database.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dutyboard
DB_USERNAME=dutyboard
DB_PASSWORD=dutyboard

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# DutyBoard doesn't send email (docs/decisions/0004).
MAIL_MAILER=log

BCRYPT_ROUNDS=12

# Linux only: if your user ID isn't 1000 (check with `id -u` and `id -g`),
# set these so files the containers write belong to you.
# DUTYBOARD_UID=1000
# DUTYBOARD_GID=1000
